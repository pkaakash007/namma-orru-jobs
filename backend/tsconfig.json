    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "service-account.json"]
}
